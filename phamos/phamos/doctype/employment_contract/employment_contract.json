  },
  {
   "fieldname": "monthly_amount",
   "fieldtype": "Currency",
   "label": "Agreed Monthly Amount",
   "options": "currency",
   "depends_on": "eval:doc.contract_type=='External'",
   "mandatory_depends_on": "eval:doc.contract_type=='External'"
  },
  {
   "fieldname": "monthly_gross",
   "fieldtype": "Currency",
   "label": "Monthly Gross",
   "options": "currency",
   "read_only": 1,
   "description": "Employed: yearly gross × FTE % ÷ 12. External: the agreed monthly amount."
  },
  {
   "fieldname": "expense_account",
   "fieldtype": "Link",
   "label": "Expense Account",
   "options": "Account"
  },
  {
   "fieldname": "section_break_history",
   "fieldtype": "Section Break",
   "label": "Contract History",
   "depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "contract_history",
   "fieldtype": "HTML",
   "label": "Contract History"
  },
  {
   "fieldname": "section_break_notes",
   "fieldtype": "Section Break",
   "label": "Notes",
   "collapsible": 1,
   "collapsible_depends_on": "notes"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Employment Contract",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1,
   "search_index": 1
  }
