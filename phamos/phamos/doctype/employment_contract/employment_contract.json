  },
  {
   "fieldname": "continuation_of",
   "fieldtype": "Link",
   "label": "Continuation Of",
   "options": "Employment Contract",
   "read_only": 1,
   "no_copy": 1,
   "depends_on": "continuation_of",
   "description": "Created automatically to resume the earlier terms after this temporary change."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nUpcoming\nActive\nExpired\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "no_copy": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "hidden": 1
  },
  {
   "fieldname": "section_break_terms",
   "fieldtype": "Section Break",
   "label": "Working Time & Pay"
  },
  {
   "fieldname": "fte_percentage",
   "fieldtype": "Percent",
   "label": "FTE %",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "full_time_hours_per_week",
   "fieldtype": "Float",
   "label": "Full-Time Hours per Week",
   "default": "40",
   "reqd": 1
  },
  {
   "fieldname": "weekly_hours",
   "fieldtype": "Float",
   "label": "Weekly Hours",
   "read_only": 1,
   "description": "FTE % × full-time hours per week"
  },
  {
   "fieldname": "column_break_terms",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "reqd": 1,
