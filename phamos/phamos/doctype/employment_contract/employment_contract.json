   "fetch_if_empty": 1
  },
  {
   "fieldname": "yearly_gross_full_time",
   "fieldtype": "Currency",
   "label": "Yearly Gross (100 %)",
   "options": "currency",
   "depends_on": "eval:doc.contract_type=='Employed'",
