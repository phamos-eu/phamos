   "fetch_if_empty": 1
  },
  {
   "fieldname": "contract_type",
   "fieldtype": "Select",
   "label": "Contract Type",
   "options": "Employed\nExternal",
   "default": "Employed",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_header",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "effective_from",
   "fieldtype": "Date",
   "label": "Effective From",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "valid_until",
   "fieldtype": "Date",
   "label": "Valid Until",
